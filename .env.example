# Required for live SEC downloads. Must identify the requester.
# Format: "Organization or Name contact@example.com"
SEC_USER_AGENT=

# Production data root (objects, bundles, acquisition-attempts, locks)
# EDGAR_DATA_ROOT=var

# Persistent application catalog (consumed by Settings / edgar db * / filings catalog).
# Not required for filings retrieve.
# EDGAR_DATABASE_URL=postgresql+psycopg://edgar:edgar@localhost:5432/edgar

# Disposable integration-test database (process env only — not a Settings field).
# Database tests TRUNCATE and migrate this database. Must be named exactly edgar_test.
# Supply via `uv run --env-file .env pytest -m database` or export.
# EDGAR_TEST_DATABASE_URL=postgresql+psycopg://edgar:edgar@localhost:5432/edgar_test

# SEC_REQUESTS_PER_SECOND=5
# SEC_TIMEOUT_SECONDS=60
# SEC_MAX_RETRIES=4
# MAX_REDIRECTS=5
# MAX_FILE_BYTES=104857600
# MAX_BUNDLE_BYTES=524288000
# MAX_EXTERNAL_DEPENDENCY_BYTES=524288000
