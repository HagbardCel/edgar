{
  "definitions": [
    {
      "metric_code": "operating_company_revenue",
      "definition_version": 1,
      "family_code": "revenue",
      "name": "Operating company revenue",
      "economic_definition": "Revenue from ordinary operating activities for a consolidated non-financial operating company.",
      "accounting_basis": "us_gaap",
      "period_type": "duration",
      "value_kind": "monetary",
      "unit_kind": "currency",
      "entity_scope": "consolidated",
      "sign_convention": "positive_revenue",
      "constraints": {
        "inclusion_rules": [
          "Product and service revenue from core operating activities before operating expenses."
        ],
        "exclusion_rules": [
          "Banking net revenue",
          "Insurance premiums",
          "Investment income",
          "Regulated utility revenue"
        ],
        "statement_expectations": [
          "income_statement"
        ],
        "industry_applicability": [
          "non_financial_operating_companies"
        ],
        "aggregation_behavior": "additive_over_disjoint_periods",
        "derivation_policy": "direct_only"
      },
      "dimension_policy": "undimensioned_only"
    },
    {
      "metric_code": "gross_profit",
      "definition_version": 1,
      "family_code": "profit",
      "name": "Gross profit",
      "economic_definition": "Revenue minus cost of goods sold for consolidated operations.",
      "accounting_basis": "us_gaap",
      "period_type": "duration",
      "value_kind": "monetary",
      "unit_kind": "currency",
      "entity_scope": "consolidated",
      "sign_convention": "natural_sign",
      "constraints": {
        "inclusion_rules": [
          "Total revenue less cost of revenue or cost of goods sold."
        ],
        "exclusion_rules": [
          "Operating income",
          "Segment gross profit without consolidated total"
        ],
        "statement_expectations": [
          "income_statement"
        ],
        "industry_applicability": [
          "general"
        ],
        "aggregation_behavior": "additive_over_disjoint_periods",
        "derivation_policy": "direct_only"
      },
      "dimension_policy": "undimensioned_only"
    },
    {
      "metric_code": "operating_income",
